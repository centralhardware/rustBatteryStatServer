#!/bin/sh
PLIST=/Library/LaunchDaemons/me.centralhardware.battery-agent.plist
PREFS=/Library/Preferences/me.centralhardware.battery-agent

# Ask for the server URL on first install; upgrades keep the stored one.
if ! /usr/bin/defaults read "$PREFS" ServerURL >/dev/null 2>&1; then
    CONSOLE_USER=$(/usr/bin/stat -f %Su /dev/console)
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
        URL=$(/bin/launchctl asuser "$(/usr/bin/id -u "$CONSOLE_USER")" /usr/bin/osascript \
            -e 'text returned of (display dialog "BatteryStatServer URL:" default answer "https://" with title "battery-agent")' 2>/dev/null)
        case "$URL" in
            http://?*|https://?*) /usr/bin/defaults write "$PREFS" ServerURL -string "$URL" ;;
        esac
    fi
fi
/usr/sbin/chown root:wheel "$PLIST" /usr/local/libexec/battery-agent
/bin/chmod 644 "$PLIST"
/bin/launchctl bootstrap system "$PLIST"
/bin/launchctl enable system/me.centralhardware.battery-agent
exit 0
